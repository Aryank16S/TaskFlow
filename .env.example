# ============================================================================
# TaskFlow Studio — Database & Authentication Configuration
# Copy this file to .env.local to connect PostgreSQL or MySQL.
# If omitted, TaskFlow automatically uses its built-in Local SQL/JSON DB Engine.
# ============================================================================

# Option 1: PostgreSQL Connection String (Neon, Supabase, Local Postgres)
# DATABASE_URL="postgresql://postgres:password@localhost:5432/taskflow"

# Option 2: MySQL Connection String (Local MySQL 8+, PlanetScale, TiDB, Aiven)
# DATABASE_URL="mysql://root:password@localhost:3306/taskflow"

# Authentication Secret for HMAC Session Tokens
AUTH_SECRET="taskflow-studio-enterprise-secret-key-2026"

